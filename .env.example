# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Base HTTPS URL of your Supabase project (e.g. https://xyz.supabase.co).
# Configure in Settings > Secrets to enable persistent storage via Supabase Data API.
SUPABASE_URL=""

# SUPABASE_SECRET_KEY: Service role / secret key for Supabase Data API (server-side only).
# Configure in Settings > Secrets. Never expose this key to the browser.
SUPABASE_SECRET_KEY=""

# ADMIN_PASSCODE: Required in Supabase mode to authenticate into /painel.
# Configure in Settings > Secrets.
ADMIN_PASSCODE=""

# SESSION_SECRET: Required in Supabase mode to sign administrative Bearer session tokens.
# Configure in Settings > Secrets with a long random string.
SESSION_SECRET=""
